# ========================================================
# CONFIGURACIÓN DE ENTORNO - RAFA TURNOS HOSPITALARIOS
# ========================================================

# Base de Datos PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=turnos

# URL de conexión para Prisma (dentro de Docker usa 'db', en local usa 'localhost')
DATABASE_URL="postgresql://admin:admin123@db:5432/turnos?schema=public"

# Integración SSO con Intranet Hospitalaria
INTRANET_JWT_SECRET="clave_secreta_compartida_con_intranet_hospitalaria"
INTRANET_RETURN_URL="http://localhost:4300"

# Puerto HTTP del Backend
PORT=3000
