# Conexión PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rafa_turnos?schema=public"

# Puerto Backend NestJS
PORT=3000

# Integración Satélite con Intranet Hospitalaria (SSO JWT y REST API)
INTRANET_JWT_SECRET="clave_secreta_compartida_con_intranet_hospitalaria"
INTRANET_API_BASE_URL="https://intranet.hospital.gov.co/api/v1"
INTRANET_API_KEY="api_key_interna_lectura_maestros"
INTRANET_RETURN_URL="https://intranet.hospital.gov.co/dashboard"
