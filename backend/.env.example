# =============================================================================
# PLANTILLA DE CONFIGURACIÓN DE ENTORNO (COPIAR COMO .env)
# =============================================================================

# Conexión PostgreSQL (Prisma ORM)
# Para entorno local con docker-compose.yml: usuario admin / contraseña admin123
DATABASE_URL="postgresql://admin:admin123@localhost:5432/turnos?schema=public"

# Puerto Backend NestJS
PORT=3000

# Integración Satélite con Intranet Hospitalaria (SSO JWT y REST API)
# En producción o staging, reemplazar por las credenciales reales de la Intranet:
INTRANET_JWT_SECRET="CAMBIAR_POR_SECRETO_COMPARTIDO_JWT"
INTRANET_API_BASE_URL="https://intranet.hospital.ejemplo.gov.co/api/v1"
INTRANET_API_KEY="CAMBIAR_POR_API_KEY_AUTORIZADA"
INTRANET_RETURN_URL="https://intranet.hospital.ejemplo.gov.co/dashboard"
