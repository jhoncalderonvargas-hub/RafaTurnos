generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoCuadrante {
  BORRADOR
  VALIDADO
  PUBLICADO
  CERRADO_NOMINA
}

enum EstadoPermuta {
  PENDIENTE_PAR
  PENDIENTE_SUPERVISOR
  APROBADA
  RECHAZADA
}

model EmpresaContratante {
  id                             String     @id @default(uuid())
  codigo                         String     @unique
  nombre                         String
  nit                            String?    @unique
  aliasesCodigo                  String[]   @default([])
  estadoConfiguracion            String     @default("CONFIRMADA") // CONFIRMADA | PENDIENTE_REGLAS
  plantillaNormativa             String     @default("CST_LEY_2466") // DECRETO_1042 | CST_LEY_2466 | PERSONALIZADA
  horasSemanalesContrato         Float      @default(42)
  diasBaseSemana                 Int        @default(6)
  horaInicioNocturnoMin          Int        @default(1140) // 18:00 = 1080, 19:00 = 1140
  horaFinNocturnoMin             Int        @default(360)  // 06:00 = 360
  porcentajeRecargoNocturno      Float      @default(0.35)
  modoRecargoDominical           String     @default("LEY_2466") // LEY_2466 | FIJO
  porcentajeRecargoDominicalFijo Float?
  aplicaTopeHorasExtrasSemanal   Boolean    @default(true)
  topeHorasExtrasSemanal         Float      @default(12)
  usaBancoHoras                  Boolean    @default(true)
  activa                         Boolean    @default(true)
  observaciones                  String?
  creadoEn                       DateTime   @default(now())
  actualizadoEn                  DateTime   @updatedAt
  empleados                      Empleado[]

  @@map("empresas_contratantes")
}

model Macroproceso {
  id                      String     @id @default(uuid())
  codigo                  String     @unique
  nombre                  String
  nombreCorto             String
  tipoProceso             String     @default("MISIONAL_ASISTENCIAL")
  icono                   String     @default("🏥")
  orden                   Int        @default(1)
  modalidadSugerida       String     @default("TODOS_24_7")
  plantillaTurnosSugerida String     @default("ROTATIVO_8H")
  servicios               Servicio[]

  @@map("macroprocesos")
}

model Servicio {
  id                        String                   @id @default(uuid())
  intranetId                String?                  @unique
  codigo                    String                   @unique
  nombre                    String
  macroprocesoId            String
  macroproceso              Macroproceso             @relation(fields: [macroprocesoId], references: [id])
  reqDia                    Int                      @default(4)
  reqNoche                  Int                      @default(2)
  modalidadDias             String                   @default("TODOS_24_7")
  reqDiaDomFest             Int                      @default(2)
  reqNocheDomFest           Int                      @default(1)
  permitePermutaEntreCargos Boolean                  @default(false)
  turnosHabilitadosCodigos  String[]                 @default(["M8", "T8", "N8", "M6", "T6", "N12", "D12", "G24", "ADM", "MD", "AP", "DISP", "S", "L", "COMP", "FAM", "VAC", "INC", "LIC"])
  empleadosBase             Empleado[]               @relation("ServicioBase")
  cuadrantes                Cuadrante[]
  asignacionesEjecutadas    AsignacionTurno[]        @relation("ServicioEjecutor")
  cargosPermitidos          ServicioCargoPermitido[]
  metasPorTurno             ServicioTurnoMeta[]
  coberturas                RequerimientoCobertura[]
  turnosHabilitados         ServicioTurnoHabilitado[]
  permutas                  SolicitudPermuta[]
  auditorias                AuditoriaCambio[]        @relation("AuditoriasServicio")

  // Relación de Servicios Hermanos (Afinidad clínica/técnica para rotación)
  serviciosHermanosOrigen  ServicioHermano[]       @relation("ServicioOrigen")
  serviciosHermanosDestino ServicioHermano[]       @relation("ServicioHermano")

  @@index([macroprocesoId])
  @@map("servicios")
}

model ServicioCargoPermitido {
  id          String               @id @default(uuid())
  servicioId  String
  servicio    Servicio             @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  categoriaId String
  categoria   CategoriaProfesional @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([servicioId, categoriaId])
  @@index([categoriaId])
  @@map("servicios_cargos_permitidos")
}

model ServicioTurnoMeta {
  id              String    @id @default(uuid())
  servicioId      String
  servicio        Servicio  @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  tipoTurnoId     String
  tipoTurno       TipoTurno @relation(fields: [tipoTurnoId], references: [id], onDelete: Cascade)
  habilitado      Boolean   @default(true)
  minimoBase      Int       @default(1)
  esperadoBase    Int       @default(1)
  minimoDomFest   Int       @default(1)
  esperadoDomFest Int       @default(1)

  @@unique([servicioId, tipoTurnoId])
  @@index([tipoTurnoId])
  @@map("servicios_turnos_metas")
}

model ServicioHermano {
  id                String   @id @default(uuid())
  servicioId        String
  servicio          Servicio @relation("ServicioOrigen", fields: [servicioId], references: [id], onDelete: Cascade)
  servicioHermanoId String
  servicioHermano   Servicio @relation("ServicioHermano", fields: [servicioHermanoId], references: [id], onDelete: Cascade)

  @@unique([servicioId, servicioHermanoId])
  @@map("servicios_hermanos")
}

model ServicioTurnoHabilitado {
  id           String               @id @default(uuid())
  servicioId   String
  servicio     Servicio             @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  categoriaId  String
  categoria    CategoriaProfesional @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  tipoTurnoId  String
  tipoTurno    TipoTurno            @relation(fields: [tipoTurnoId], references: [id], onDelete: Cascade)
  habilitado   Boolean              @default(true)

  @@unique([servicioId, categoriaId, tipoTurnoId])
  @@map("servicios_turnos_habilitados")
}

model CategoriaProfesional {
  id                  String                    @id @default(uuid())
  nombre              String                    @unique
  empleados           Empleado[]
  coberturas          RequerimientoCobertura[]
  turnosHabilitados   ServicioTurnoHabilitado[]
  serviciosPermitidos ServicioCargoPermitido[]

  @@map("categorias_profesionales")
}

model Empleado {
  id                   String               @id @default(uuid())
  intranetId           String?              @unique
  documento            String               @unique
  nombre               String
  correo               String?
  horasSemanalesLey    Int                  @default(42)
  horasContratoMes     Int                  @default(168)
  horasSemanalesOverride Float?
  empresaContratanteId String
  empresaContratante   EmpresaContratante   @relation(fields: [empresaContratanteId], references: [id])
  servicioBaseId       String
  servicioBase         Servicio             @relation("ServicioBase", fields: [servicioBaseId], references: [id])
  categoriaId          String
  categoria            CategoriaProfesional @relation(fields: [categoriaId], references: [id])
  asignaciones         AsignacionTurno[]
  saldosBancoHoras     BancoHorasSaldo[]
  novedades            NovedadAusencia[]
  tokensCalendario     TokenCalendario[]
  permutasSolicitadas  SolicitudPermuta[]   @relation("PermutasSolicitadas")
  permutasRecibidas    SolicitudPermuta[]   @relation("PermutasRecibidas")
  auditorias           AuditoriaCambio[]    @relation("AuditoriasEmpleado")

  @@index([empresaContratanteId])
  @@index([servicioBaseId])
  @@index([categoriaId])
  @@map("empleados")
}

model TipoTurno {
  id                     String                    @id @default(uuid())
  codigo                 String                    @unique // M8, T8, N8, M6, T6, N12, D12, G24, ADM, COMP, etc.
  nombre                 String
  horaInicio             String
  horaFin                String
  horasOrdinarias        Float
  horasDiurnas           Float
  horasNocturnas         Float
  minutosAlmuerzo        Int                       @default(0) // Minutos de almuerzo no computables (Art. 167 CST)
  colorHex               String
  descuentaBancoHoras    Boolean                   @default(false)
  modoAmortizacionBanco  String                    @default("HORAS_FIJAS") // DIA_HABIL_EMPRESA | HORAS_FIJAS
  horasAmortizacionBanco Float                     @default(8) // Horas que amortiza cuando modoAmortizacionBanco = HORAS_FIJAS
  prorrateaMetaContrato  Boolean                   @default(false) // Configurable en turnos de descanso 0h (descuenta 1 día hábil)
  esAusencia             Boolean                   @default(false)
  bloqueaPermutas        Boolean                   @default(false)
  esNocturnoPesado       Boolean                   @default(false) // Obliga a S o L al día siguiente
  esSistemaObligatorio   Boolean                   @default(false) // BLANCO, L, S, COMP, VAC, INC, LIC, FAM
  visibleEnPaleta        Boolean                   @default(true)
  activo                 Boolean                   @default(true)
  asignaciones           AsignacionTurno[]
  turnosHabilitados      ServicioTurnoHabilitado[]
  metasPorServicio       ServicioTurnoMeta[]

  @@map("tipos_turno")
}

model RequerimientoCobertura {
  id              String               @id @default(uuid())
  servicioId      String
  servicio        Servicio             @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  categoriaId     String
  categoria       CategoriaProfesional @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  reqDia          Int                  @default(1)
  reqNoche        Int                  @default(0)
  reqDiaDomFest   Int                  @default(1)
  reqNocheDomFest Int                  @default(0)

  @@unique([servicioId, categoriaId])
  @@map("requerimientos_cobertura")
}

model Cuadrante {
  id           String            @id @default(uuid())
  anio         Int
  mes          Int
  servicioId   String
  servicio     Servicio          @relation(fields: [servicioId], references: [id])
  estado       EstadoCuadrante   @default(BORRADOR)
  asignaciones AsignacionTurno[]

  @@unique([anio, mes, servicioId])
  @@map("cuadrantes")
}

model AsignacionTurno {
  id                 String            @id @default(uuid())
  cuadranteId        String
  cuadrante          Cuadrante         @relation(fields: [cuadranteId], references: [id])
  empleadoId         String
  empleado           Empleado          @relation(fields: [empleadoId], references: [id])
  tipoTurnoId        String
  tipoTurno          TipoTurno         @relation(fields: [tipoTurnoId], references: [id])
  servicioEjecutorId String
  servicioEjecutor   Servicio          @relation("ServicioEjecutor", fields: [servicioEjecutorId], references: [id])
  fecha              DateTime          @db.Date
  esRotacion         Boolean           @default(false)
  codigoPrevisto     String?
  nota               String?
  fijada             Boolean           @default(false)
  hod                Float             @default(0)
  hon                Float             @default(0)
  hdfd               Float             @default(0)
  hdfn               Float             @default(0)
  hed                Float             @default(0)
  hen                Float             @default(0)
  auditorias         AuditoriaCambio[]

  @@unique([empleadoId, fecha])
  @@index([cuadranteId, fecha])
  @@index([servicioEjecutorId])
  @@index([tipoTurnoId])
  @@index([fecha])
  @@map("asignaciones_turno")
}

model BancoHorasSaldo {
  id                       String   @id @default(uuid())
  empleadoId               String
  empleado                 Empleado @relation(fields: [empleadoId], references: [id])
  anio                     Int
  mes                      Int
  saldoInicial             Float    @default(0) // Arrastrado del mes anterior (sin caducidad)
  horasTrabajadas          Float    @default(0)
  horasContratadasNominales Float   @default(0)
  horasExoneradas          Float    @default(0)
  horasContratadas         Float    @default(168)
  diasHabilesMes           Int      @default(0)
  diasHabilesProrrateados  Int      @default(0)
  horasSemanalesAplicadas  Float    @default(42)
  empresaCodigoSnapshot    String?
  horasAmortizadasComp     Float    @default(0)
  diferenciaMes            Float    @default(0)
  saldoFinalAcumulado      Float    @default(0) // Pasa como saldoInicial al mes M+1
  actualizadoEn            DateTime @updatedAt

  @@unique([empleadoId, anio, mes])
  @@index([anio, mes])
  @@map("banco_horas_saldos")
}

model FestivoColombia {
  id              String   @id @default(uuid())
  fecha           DateTime @unique @db.Date
  anio            Int
  nombre          String
  esIrrenunciable Boolean  @default(true)
  esOficialLey    Boolean  @default(true) // False cuando es Día Cívico decretado por el hospital
  creadoEn        DateTime @default(now())

  @@index([anio])
  @@map("festivos_colombia")
}

model NovedadAusencia {
  id          String   @id @default(uuid())
  empleadoId  String
  empleado    Empleado @relation(fields: [empleadoId], references: [id])
  tipo        String   // VAC, INC, LIC
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  codigoCie10 String?  // Confidencial: solo visible para Gestión Humana (Habeas Data)

  @@index([empleadoId])
  @@index([fechaInicio, fechaFin])
  @@index([empleadoId, fechaInicio, fechaFin])
  @@map("novedades_ausencia")
}

model AuditoriaCambio {
  id                String           @id @default(uuid())
  asignacionTurnoId String?
  asignacionTurno   AsignacionTurno? @relation(fields: [asignacionTurnoId], references: [id], onDelete: SetNull)
  servicioId        String?
  servicio          Servicio?        @relation("AuditoriasServicio", fields: [servicioId], references: [id], onDelete: SetNull)
  empleadoId        String?
  empleado          Empleado?        @relation("AuditoriasEmpleado", fields: [empleadoId], references: [id], onDelete: SetNull)
  actorId           String
  tipoAccion        String           @default("EDICION_TURNO")
  turnoAnterior     String?
  turnoNuevo        String?
  justificacion     String
  fechaObjetivo     DateTime?        @db.Date
  faseCuadrante     String           @default("PUBLICADO")
  origenAccion      String           @default("MANUAL")
  esDetalleLote     Boolean          @default(false)
  timestamp         DateTime         @default(now())

  @@index([asignacionTurnoId])
  @@index([servicioId])
  @@index([empleadoId])
  @@index([empleadoId, fechaObjetivo])
  @@index([tipoAccion])
  @@index([faseCuadrante, esDetalleLote, timestamp])
  @@index([timestamp])
  @@index([servicioId, timestamp])
  @@map("auditorias_cambio")
}

model TokenCalendario {
  id         String   @id @default(uuid())
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  tokenHash  String   @unique
  activo     Boolean  @default(true)
  creadoEn   DateTime @default(now())

  @@index([empleadoId, activo])
  @@map("tokens_calendario")
}

model SolicitudPermuta {
  id               String        @id @default(uuid())
  fechaSolicitud   DateTime      @default(now())
  solicitanteId    String
  solicitante      Empleado      @relation("PermutasSolicitadas", fields: [solicitanteId], references: [id])
  receptorId       String
  receptor         Empleado      @relation("PermutasRecibidas", fields: [receptorId], references: [id])
  servicioId       String
  servicio         Servicio      @relation(fields: [servicioId], references: [id])
  anio             Int           // Periodo obligatorio del cuadrante sobre el que se solicita el cambio
  mes              Int
  diaOrigen        Int
  turnoOrigen      String
  diaDestino       Int
  turnoDestino     String
  estado           EstadoPermuta @default(PENDIENTE_SUPERVISOR)
  validacionReglas String
  motivoRechazo    String?
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  @@index([servicioId])
  @@index([solicitanteId])
  @@index([receptorId])
  @@index([estado])
  @@index([anio, mes])
  @@map("solicitudes_permuta")
}
